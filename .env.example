APP_NAME=Starter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# Admin & API Configuration
APP_X_API_TOKEN=
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD="Admin@123#"

# Optional: a real Sanctum PAT, used only so `composer api-docs` (Scribe) can fetch real
# example responses for @authenticated endpoints. Never committed, never shown in the docs.
SCRIBE_AUTH_KEY=

# Hostinger API token (hPanel → API). Optional: only used by the deploy panel's
# "Provision on Hostinger" buttons, which create a flavor's subdomain and database.
# LOCAL ONLY — never put this in .env.production. The deploy panel does not exist on a
# live server (it is gated to the local environment), and .env.production is copied
# verbatim onto every deploy target, so there it would only be a credential that can
# create and delete databases and subdomains across the whole hosting account.
HOSTINGER_API_TOKEN=

# Feature Flags
APP_USERS=true
APP_GUESTS=true
FCM_TOPICS=guests,users
AUTH_MODE=password
HAS_TRANSLATIONS=true
HAS_NOTIFICATION_TEMPLATES=true
HAS_PAGES=true
# Page slugs the CMS may never delete. PageSeeder creates any that are missing.
PROTECTED_PAGES=terms,privacy
HAS_APP_SETTINGS=true
HAS_ACTIVITY_LOGS=true
HAS_DYNAMIC_STORAGE=true
# Opens POST/DELETE on /api/translations and /api/media so a client app can seed content
# into MySQL. Turn on for the one seeding run, then turn it back off — those endpoints are
# authenticated only by the X-API-TOKEN that ships inside every mobile binary.
ALLOW_CONTENT_SEEDING=true
MEDIA_MAX_IMAGE_KB=2048
MEDIA_MAX_VIDEO_KB=20480
MEDIA_MAX_FILE_KB=10240
# Testing mode: OTPs come back in the API response, are always 123456, and register
# leaves the account unverified so the OTP step is exercised. Never true in production.
IS_TESTING=true
AUTH_IDENTIFIERS=email
HAS_EMAIL_FIELD=true
HAS_PHONE_FIELD=false
HAS_USERNAME_FIELD=false
IS_OTP_WHATSAPP=false
ACCOUNT_DELETION_RETENTION_DAYS=30
MULTI_SESSION_ENABLED=true
FIREBASE_CREDENTIALS=storage/app/private/firebase-auth.json

# API Rate Limiting (requests per decay window in minutes)
RATE_LIMIT_API=60
RATE_LIMIT_API_DECAY=1
RATE_LIMIT_AUTH=5
RATE_LIMIT_AUTH_DECAY=1
RATE_LIMIT_OTP=3
RATE_LIMIT_OTP_DECAY=5

# App-store reviewer accounts. Exempt from the deletion purge so a review
# team can delete and re-create the same account. Leave blank if unused.
APPLE_REVIEWER_EMAIL=
APPLE_REVIEWER_PASSWORD=
GOOGLE_REVIEWER_EMAIL=
GOOGLE_REVIEWER_PASSWORD=
APPGALLERY_REVIEWER_EMAIL=
APPGALLERY_REVIEWER_PASSWORD=

# Lets `migrate:fresh` / `db:wipe` run against a production database. Keep false;
# the deploy panel sets it inline for the destructive deploy option only.
ALLOW_DESTRUCTIVE_MIGRATIONS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# LOG_STACK defaults to `daily` (rotating, LOG_DAILY_DAYS of retention).
# Use `single` for one un-rotated laravel.log.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production — otherwise the admin session cookie can travel
# over plain HTTP. `php artisan app:assert-production-safety` enforces this.
SESSION_SECURE_COOKIE=false

# Hosts that receive stateful (cookie) auth from the SPA. Blank = the localhost
# defaults plus APP_URL. Add your production domain when deploying.
SANCTUM_STATEFUL_DOMAINS=
# Mobile token lifetime in minutes (43200 = 30 days). 0 or blank = never expires.
SANCTUM_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Pusher Broadcasting (optional - configure in DevSettings)
# Use BROADCAST_CONNECTION=pusher when ready
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_PORT=443
PUSHER_SCHEME=https

# Social Authentication (optional)
SOCIAL_AUTH_PROVIDERS=
SOCIAL_AUTH_MAX_ACCOUNTS=0

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_ENCRYPTION=ssl
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

INERTIA_SSR_ENABLED=false

ALLOWED_PHONE_COUNTRIES=all
ALLOWED_EMAIL_DOMAINS=all
